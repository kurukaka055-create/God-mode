local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
end)

local Events = ReplicatedStorage:WaitForChild("Events")
local attackMobRemote = Events:WaitForChild("attackMobRemote")
local meleeHitRemote = Events:WaitForChild("meleeHitRemote")
local collectRemote = Events:WaitForChild("collectResourceRemote")
local EntitiesFolder = Workspace:WaitForChild("Game"):WaitForChild("Entities")

local Toggles = {
    KillAura = false,
    GodMode = false,
    AutoChest = false,
    AutoCollect = false,
    InfStamina = false
}

local Settings = {
    KillAuraRange = 25
}

-- Anti-Damage Metamethod Hook
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if Toggles.GodMode and (method == "FireServer" or method == "InvokeServer") then
            if self.Name == "mobRangedHitRemote" or self.Name == "rangedHitRemote" or (self.Name == "meleeHitRemote" and args[1] == Character) then
                return nil
            end
        end
        return oldNamecall(self, ...)
    end)
end)

local function getNearbyEntities(range)
    local list = {}
    if not RootPart then return list end
    for _, mob in ipairs(EntitiesFolder:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChildWhichIsA("BasePart")
        if hrp then
            local dist = (RootPart.Position - hrp.Position).Magnitude
            if dist <= range then
                table.insert(list, {Mob = mob, HRP = hrp, Dist = dist})
            end
        end
    end
    return list
end

-- Stealth / Mob Ignore Engine
local stealthConnection = nil
local function toggleStealthGodMode(state)
    if state then
        stealthConnection = RunService.Heartbeat:Connect(function()
            if Character and Toggles.GodMode then
                for _, part in ipairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanQuery = false
                        part.CanTouch = false
                    end
                end
                
                local hum = Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    hum.Sit = false
                end
            end
        end)
    else
        if stealthConnection then
            stealthConnection:Disconnect()
            stealthConnection = nil
        end
        if Character then
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanQuery = true
                    part.CanTouch = true
                end
            end
        end
    end
end

-- Kill Aura Loop
task.spawn(function()
    while true do
        if Toggles.KillAura and RootPart then
            local targets = getNearbyEntities(Settings.KillAuraRange)
            for _, entry in ipairs(targets) do
                pcall(function()
                    attackMobRemote:FireServer(entry.Mob)
                    meleeHitRemote:FireServer(entry.Mob, entry.HRP.Position)
                end)
            end
        end
        task.wait(0.1)
    end
end)

-- Auto Collect & Chests
task.spawn(function()
    while true do
        if (Toggles.AutoChest or Toggles.AutoCollect) and RootPart then
            pcall(function()
                local dropped = Workspace.Game:FindFirstChild("DroppedItems")
                if dropped and Toggles.AutoCollect then
                    for _, item in ipairs(dropped:GetChildren()) do
                        local part = item:FindFirstChildWhichIsA("BasePart")
                        if part and (RootPart.Position - part.Position).Magnitude <= 30 then
                            collectRemote:FireServer(item)
                        end
                    end
                end
                
                local chestFolder = Workspace.Game:FindFirstChild("Chest")
                if chestFolder and Toggles.AutoChest then
                    local chestRemote = ReplicatedStorage.Engine.Service.ChestService:FindFirstChild("RequestOpenEvent")
                    if chestRemote then
                        for _, chest in ipairs(chestFolder:GetChildren()) do
                            local part = chest:FindFirstChildWhichIsA("BasePart")
                            if part and (RootPart.Position - part.Position).Magnitude <= 25 then
                                chestRemote:FireServer(chest)
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.4)
    end
end)

